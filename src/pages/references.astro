---
import { SITE } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `Data References | ${SITE.name}`,
  description: 'Formal documentation and source links for all truck safety data and litigation statistics cited on this site.',
  url: new URL('/references', SITE.url).toString(),
};

const references = [
  {
    id: 1,
    title: 'Traffic Safety Facts: Large Trucks (2022 Data)',
    source: 'National Highway Traffic Safety Administration (NHTSA)',
    description: 'Data confirming that large trucks are significantly more likely to be involved in fatal collisions per mile traveled compared to passenger vehicle occupants on interstate corridors.',
    link: 'https://www.nhtsa.gov/book/statistics/trucks'
  },
  {
    id: 2,
    title: 'FMCSA Safety Measurement System (SMS) Methodology',
    source: 'Federal Motor Carrier Safety Administration (FMCSA)',
    description: 'The federal scoring system used to identify high-risk carriers based on crash history, maintenance violations, and HOS compliance failures.',
    link: 'https://ai.fmcsa.dot.gov/sms/'
  },
  {
    id: 3,
    title: 'Large Truck Crash Causation Study (LTCCS)',
    source: 'FMCSA / U.S. DOT',
    description: 'Comprehensive forensic data showing that driver fatigue and brake system failures are the leading proximate causes of multi-vehicle commercial collisions.',
    link: 'https://www.fmcsa.dot.gov/safety/research-and-analysis/large-truck-crash-causation-study-ltccs-0'
  },
  {
    id: 4,
    title: 'Analysis of Commercial Vehicle Braking Performance',
    source: 'Insurance Institute for Highway Safety (IIHS)',
    description: 'Technical standards for tractor-trailer stopping distances, establishing the 400% delta between commercial and passenger vehicle kinetic physics.',
    link: 'https://www.iihs.org/'
  }
];
---

<BaseLayout 
  title={`Truck Safety Data & Litigation References | ${SITE.name}`} 
  description="Technical documentation and safety data sources for truck accident litigation in New Brunswick and across New Jersey corridors." 
  jsonLd={jsonLd}
>
  <div class="pt-32 pb-20 bg-background border-b border-border" data-ps="src/pages/references.astro:dyuq7z">
    <Container>
      <div class="max-w-4xl" data-ps="src/pages/references.astro:dyuq7y">
        <h1 class="text-h1 font-black mb-8 leading-none" data-ps="src/pages/references.astro:2cx0ef">DATA <span class="text-primary" data-ps="src/pages/references.astro:firubi">REFERENCES</span></h1>
        <p class="text-xl text-muted-foreground leading-relaxed max-w-2xl" data-ps="src/pages/references.astro:5z2avr">
          Our New Brunswick semi-truck accident litigation is backed by hard technical data. This repository contains the formal documentation and source links for all safety statistics cited on this site.
        </p>
      </div>
    </Container>
  </div>

  <section class="py-20 bg-surface" data-ps="src/pages/references.astro:upvc8">
    <Container>
      <div class="max-w-4xl space-y-16" data-ps="src/pages/references.astro:dyuq7x">
        {references.map((ref, __psIdx) => (
          <div class="border-l-4 border-primary pl-8 py-4" data-ps={`src/pages/references.astro:dyuq7w-${__psIdx}`}>
            <div class="text-xs font-mono text-primary mb-2" data-ps={`src/pages/references.astro:dyuq7v-${__psIdx}`}>[{ref.id}]</div>
            <h2 class="text-2xl font-black font-display mb-2 tracking-tight uppercase" data-ps={`src/pages/references.astro:1etq4m-${__psIdx}`}>{ref.title}</h2>
            <div class="text-sm font-mono text-muted-foreground mb-4 uppercase tracking-widest" data-ps={`src/pages/references.astro:dyuq7u-${__psIdx}`}>{ref.source}</div>
            <p class="text-muted-foreground mb-6 leading-relaxed max-w-2xl" data-ps={`src/pages/references.astro:23jsqn-${__psIdx}`}>
              {ref.description}
            </p>
            <a 
              href={ref.link} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="inline-flex items-center gap-2 text-[10px] font-mono font-bold text-primary uppercase border-b border-primary/30 pb-1 hover:border-primary transition-all"
             data-ps={`src/pages/references.astro:14vlu1-${__psIdx}`}>
              View Source
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/Container.astro';
import ExpertNetwork from '@/components/team/ExpertNetwork.astro';
import { SITE } from '@/config/site';
import { getCollection, render } from 'astro:content';

const teamMembers = await getCollection('team', ({data}) => !data.draft);
teamMembers.sort((a, b) => a.data.order - b.data.order);
const renderedMembers = await Promise.all(teamMembers.map(async member => ({...member, ...await render(member)})));

const partnersBanner = "https://pagesmith-cdn.com/20632c09/images/Partners_2025-scaled-e1749740637683-1536-b54697-1536.webp";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `Litigation Team | ${SITE.name}`,
  "description": "Meet the named partners and high-stakes truck accident litigation team at Garces, Grabler & LeBrocq.",
  "url": `${SITE.url}/team/`
};
---

<BaseLayout title={`Litigation Team | ${SITE.name}`} description="Meet the named partners and high-stakes truck accident litigation team at Garces, Grabler & LeBrocq." jsonLd={jsonLd}>
  <section class="py-24 md:py-32 bg-background relative overflow-hidden" data-ps="src/pages/team.astro:1">
    <!-- Background Accents -->
    <div class="absolute top-0 right-0 w-1/3 h-full bg-surface/30 -skew-x-12 pointer-events-none" data-ps="src/pages/team.astro:2"></div>
    
    <Container data-ps="src/pages/team.astro:3">
      <div class="max-w-4xl mb-12 md:mb-16 relative z-10" data-ps="src/pages/team.astro:4">
        <div class="inline-flex items-center gap-3 px-3 py-1 bg-surface border border-primary/30 mb-8" data-ps="src/pages/team.astro:5">
          <span class="text-[10px] font-mono font-bold tracking-[0.2em] text-primary uppercase" data-ps="src/pages/team.astro:6">FIRM LEADERSHIP</span>
        </div>
        <h1 class="text-h1 font-black mb-8 text-foreground" data-ps="src/pages/team.astro:7">
          THE <span class="text-primary" data-ps="src/pages/team.astro:8">LITIGATION</span> TEAM.
        </h1>
        <p class="text-xl text-muted-foreground leading-tight max-w-2xl" data-ps="src/pages/team.astro:9">
          Led by our named partners, Garces, Grabler & LeBrocq brings formidable trial experience, deep regulatory insight, and relentless courtroom advocacy to every high-stakes commercial truck accident case.
        </p>
      </div>

      <!-- Partners Group Photo Exhibit Banner -->
      <div class="mb-16 border border-border bg-surface overflow-hidden relative group" data-ps="src/pages/team.astro:banner-wrap">
        <div class="relative w-full aspect-[21/9] max-h-[460px] overflow-hidden" data-ps="src/pages/team.astro:banner-img-wrap">
          <img 
            src={partnersBanner}
            alt="Garces, Grabler & LeBrocq Named Partners"
            class="w-full h-full object-cover object-top filter brightness-95 group-hover:brightness-100 transition-all duration-700"
            data-ps="src/pages/team.astro:banner-img"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-background via-transparent to-transparent opacity-80" data-ps="src/pages/team.astro:banner-grad"></div>
          <div class="absolute bottom-6 left-6 right-6 flex flex-wrap items-end justify-between gap-4" data-ps="src/pages/team.astro:banner-info">
            <div data-ps="src/pages/team.astro:a9sl7z">
              <div class="text-[10px] font-mono font-bold tracking-widest text-primary uppercase mb-1" data-ps="src/pages/team.astro:banner-sub">
                Executive Leadership
              </div>
              <div class="text-xl md:text-2xl font-black font-display text-foreground uppercase tracking-tight" data-ps="src/pages/team.astro:banner-title">
                Garces, Grabler & LeBrocq Partners
              </div>
            </div>
            <div class="text-xs font-mono text-muted-foreground bg-background/90 px-3 py-1.5 border border-border" data-ps="src/pages/team.astro:a9sl80">
              William J. Garces · William N. Grabler · Lawrence A. LeBrocq
            </div>
          </div>
        </div>
      </div>

      <!-- Named Partners Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-ps="src/pages/team.astro:10">
        {renderedMembers.map((member, index) => (
          <div class="group relative flex flex-col bg-surface border border-border p-6 hover:border-primary/50 transition-colors" data-ps="src/pages/team.astro:11">
            <div class="flex items-center justify-between mb-4 border-b border-border pb-3" data-ps="src/pages/team.astro:meta">
              <span class="text-[10px] font-mono font-bold text-primary tracking-widest uppercase" data-ps={`src/pages/team.astro:oewg2z-${index}`}>
                PARTNER 0{index + 1}
              </span>
              <span class="text-[10px] font-mono text-muted-foreground uppercase" data-ps={`src/pages/team.astro:oewg2y-${index}`}>
                GGL TRIAL COUNSEL
              </span>
            </div>
            
            <div class="relative z-10 flex-1 flex flex-col" data-ps="src/pages/team.astro:15">
              <img src={member.data.image} alt={member.data.imageAlt || member.data.title} loading="lazy" class="w-full aspect-[4/3] object-cover object-top mb-6" />
              <h2 class="text-2xl font-black font-display text-foreground mb-1 uppercase tracking-tight" data-ps="src/pages/team.astro:16">
                {member.data.title}
              </h2>
              <div class="text-[11px] font-mono font-bold tracking-wider text-primary uppercase mb-4" data-ps="src/pages/team.astro:17">
                {member.data.jobTitle}
              </div>
              <div class="text-sm text-muted-foreground leading-relaxed flex-1 prose prose-invert" data-ps="src/pages/team.astro:18">
                <member.Content />
              </div>
              
              <div class="mt-6 pt-4 border-t border-border flex items-center justify-between" data-ps={`src/pages/team.astro:a9sl81-${index}`}>
                <a 
                  href="/#contact" 
                  class="text-xs font-bold font-display uppercase tracking-widest text-foreground hover:text-primary transition-colors inline-flex items-center gap-2 no-underline"
                 data-ps={`src/pages/team.astro:849irw-${index}`}>
                  Consult Partner
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
              </div>
            </div>
            
            <!-- Technical corner accent -->
            <div class="absolute -bottom-1 -right-1 w-4 h-4 border-b-2 border-r-2 border-primary/50 opacity-0 group-hover:opacity-100 transition-opacity" data-ps="src/pages/team.astro:19"></div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <ExpertNetwork />

  <!-- CTA Section -->
  <section class="py-20 border-t border-border bg-surface" data-ps="src/pages/team.astro:20">
    <Container data-ps="src/pages/team.astro:21">
      <div class="flex flex-col md:flex-row items-center justify-between gap-12" data-ps="src/pages/team.astro:22">
        <div class="max-w-xl" data-ps="src/pages/team.astro:23">
          <h2 class="text-h3 font-black text-foreground mb-4" data-ps="src/pages/team.astro:24">DESTRUCTION COMMANDS ATTENTION.</h2>
          <p class="text-muted-foreground" data-ps="src/pages/team.astro:25">Put our named partners and trial litigators to work on your case. Corporate carriers are already building their defense—start building yours now.</p>
        </div>
        <a href="/#contact" class="px-10 py-5 bg-primary text-primary-foreground font-black font-display uppercase tracking-widest hover:bg-primary-hover transition-all hover-lift whitespace-nowrap" data-ps="src/pages/team.astro:26">
          FREE CASE CONSULTATION
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>

---
import Container from '@/components/Container.astro';
import { getCollection } from 'astro:content';
const faqs = (await getCollection('faq', ({ data }) => !data.draft)).sort((a,b) => a.data.order - b.data.order);
import { SITE } from '@/config/site';
---

<section id="faq" class="bg-dark-background py-24 md:py-32 border-t border-border" data-ps="src/components/home/FAQ.astro:f1">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16" data-ps="src/components/home/FAQ.astro:f2">
      <div class="lg:col-span-4" data-ps="src/components/home/FAQ.astro:f3">
        <div class="sticky top-[var(--nav-height)] pt-4" data-ps="src/components/home/FAQ.astro:f4">
          <div class="reveal inline-block px-3 py-1 border-l-2 border-primary text-[10px] font-mono font-bold tracking-[0.3em] text-primary uppercase mb-6" data-ps="src/components/home/FAQ.astro:f5">
            Technical Inquiry Database
          </div>
          <h2 class="reveal text-h2 font-black mb-8 leading-none" data-ps="src/components/home/FAQ.astro:f6">
            FREQUENTLY ASKED <span class="text-primary" data-ps="src/components/home/FAQ.astro:f7">QUESTIONS.</span>
          </h2>
          <p class="reveal reveal-delay-1 text-muted-foreground" data-ps="src/components/home/FAQ.astro:f8">
            Truck litigation is governed by complex federal and state statutes. Review our forensic breakdown of common legal and technical inquiries.
          </p>
          
          <div class="mt-12 hidden lg:block" data-ps="src/components/home/FAQ.astro:f9">
            <div class="p-6 border border-primary/40 bg-surface relative overflow-hidden" data-ps="src/components/home/FAQ.astro:f10">
              <div class="inline-block text-[11px] font-mono text-primary font-bold uppercase tracking-[0.2em] mb-2" data-ps="src/components/home/FAQ.astro:f11">Need Legal Guidance?</div>
              <h3 class="text-xl font-bold font-display uppercase text-foreground mb-3" data-ps="src/components/home/FAQ.astro:f12">HAVE QUESTIONS ABOUT YOUR CASE?</h3>
              <p class="text-sm text-muted-foreground mb-6 leading-relaxed" data-ps="src/components/home/FAQ.astro:f13">
                Speak directly with an experienced truck accident attorney. Consultations are 100% free and confidential.
              </p>
              <div class="space-y-3" data-ps="src/components/home/FAQ.astro:f14">
                <a 
                  href={`tel:${SITE.contact.phone.replace(/[^0-9]/g, '')}`} 
                  class="flex items-center justify-center gap-2 w-full py-3 px-4 bg-primary text-primary-foreground font-bold font-display uppercase text-xs tracking-wider hover:bg-primary-hover transition-colors no-underline"
                  data-ps="src/components/home/FAQ.astro:f15"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                  Call {SITE.contact.phone}
                </a>
                <a 
                  href="/#contact" 
                  class="flex items-center justify-center w-full py-2.5 px-4 border border-border text-foreground font-bold font-display uppercase text-xs tracking-wider hover:border-primary hover:text-primary transition-colors no-underline"
                  data-ps="src/components/home/FAQ.astro:f16"
                >
                  Request Case Evaluation
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-8 space-y-12" data-ps="src/components/home/FAQ.astro:f22">
        {faqs.map(({ data: faq }, index) => (
          <div class="reveal">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-primary font-mono text-sm font-bold">[{String(index + 1).padStart(2, '0')}]</span>
              <div class="h-px flex-grow bg-border"></div>
            </div>
            <h3 class="text-2xl font-black font-display uppercase mb-4">{faq.title}</h3>
            <p class="text-muted-foreground leading-relaxed whitespace-pre-line">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

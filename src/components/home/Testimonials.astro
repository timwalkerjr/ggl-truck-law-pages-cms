---
import Container from '@/components/Container.astro';
---

<section id="testimonials" class="py-20 md:py-28 lg:py-36 bg-surface border-y border-border relative overflow-hidden" data-ps="src/components/home/Testimonials.astro:init">
  <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(var(--color-primary) 1px, transparent 1px); background-size: 32px 32px;" data-ps="src/components/home/Testimonials.astro:rl25kq"></div>
  
  <Container>
    <div class="mb-16 md:mb-24 reveal" data-ps="src/components/home/Testimonials.astro:rl25kr">
      <span class="font-mono text-primary text-sm uppercase tracking-widest block mb-4" data-ps="src/components/home/Testimonials.astro:pdgp89">Exhibit D: Client Testimony</span>
      <h2 class="text-h2 text-foreground mb-6" data-ps="src/components/home/Testimonials.astro:o88cjo">Post-Collision Outcomes</h2>
      <div class="h-1 w-24 bg-primary" data-ps="src/components/home/Testimonials.astro:rl25ks"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12" data-ps="src/components/home/Testimonials.astro:rl25kt">
      <!-- Testimonial 1 -->
      <div class="p-8 md:p-10 border border-border bg-background relative reveal hover-glow group" data-ps="src/components/home/Testimonials.astro:rl25ku">
        <div class="absolute top-0 right-0 p-4 font-mono text-xs text-muted-foreground opacity-50 group-hover:text-primary transition-colors" data-ps="src/components/home/Testimonials.astro:rl25kv">REC_001</div>
        <div class="flex items-center gap-4 mb-8" data-ps="src/components/home/Testimonials.astro:rl25kw">
          <div class="w-12 h-12 bg-surface border border-border flex items-center justify-center font-display text-xl text-primary" data-ps="src/components/home/Testimonials.astro:rl25kx">M</div>
          <div data-ps="src/components/home/Testimonials.astro:rl25ky">
            <div class="font-mono text-sm text-foreground" data-ps="src/components/home/Testimonials.astro:rl25kz">Michael T.</div>
            <div class="font-mono text-xs text-muted-foreground" data-ps="src/components/home/Testimonials.astro:jqcpy3">Jackknife Victim // I-95</div>
          </div>
        </div>
        <p class="text-muted-foreground text-lg leading-relaxed italic mb-6" data-ps="src/components/home/Testimonials.astro:wtgrj4">
          "The insurance company tried to blame the weather. Garces, Grabler & LeBrocq pulled the black box data and proved the driver was speeding. They didn't just win my case, they dismantled the defense's entire argument."
        </p>
        <div class="font-mono text-xs text-primary mt-auto" data-ps="src/components/home/Testimonials.astro:jqcpy2">STATUS: RESOLVED // 7-FIGURE SETTLEMENT</div>
      </div>

      <!-- Testimonial 2 -->
      <div class="p-8 md:p-10 border border-border bg-background relative reveal reveal-delay-1 hover-glow group" data-ps="src/components/home/Testimonials.astro:jqcpy1">
        <div class="absolute top-0 right-0 p-4 font-mono text-xs text-muted-foreground opacity-50 group-hover:text-primary transition-colors" data-ps="src/components/home/Testimonials.astro:jqcpy0">REC_002</div>
        <div class="flex items-center gap-4 mb-8" data-ps="src/components/home/Testimonials.astro:jqcpxz">
          <div class="w-12 h-12 bg-surface border border-border flex items-center justify-center font-display text-xl text-primary" data-ps="src/components/home/Testimonials.astro:jqcpxy">S</div>
          <div data-ps="src/components/home/Testimonials.astro:jqcpxx">
            <div class="font-mono text-sm text-foreground" data-ps="src/components/home/Testimonials.astro:jqcpxw">Sarah J.</div>
            <div class="font-mono text-xs text-muted-foreground" data-ps="src/components/home/Testimonials.astro:jqcpxv">Underride Collision // Route 1</div>
          </div>
        </div>
        <p class="text-muted-foreground text-lg leading-relaxed italic mb-6" data-ps="src/components/home/Testimonials.astro:wtgrj5">
          "When you are hit by a 40-ton machine, you feel completely helpless. The team at Garces, Grabler & LeBrocq treats your case like a forensic investigation. They found logbook violations nobody else even looked for."
        </p>
        <div class="font-mono text-xs text-primary mt-auto" data-ps="src/components/home/Testimonials.astro:jqcpxu">STATUS: RESOLVED // POLICY LIMITS MAXIMIZED</div>
      </div>
    </div>
  </Container>
</section>
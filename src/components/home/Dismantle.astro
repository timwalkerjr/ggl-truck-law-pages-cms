---
import Container from '@/components/Container.astro';
---

<section id="dismantle" class="bg-background py-20 md:py-32 overflow-hidden" data-ps="src/components/home/Dismantle.astro:d1">
  <Container>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 items-center" data-ps="src/components/home/Dismantle.astro:1enepg">
      <!-- Text Side -->
      <div class="lg:col-span-7 order-2 lg:order-1" data-ps="src/components/home/Dismantle.astro:g31o5g">
        <div class="reveal inline-block px-3 py-1 border-l-2 border-primary text-[10px] font-mono font-bold tracking-[0.3em] text-primary uppercase mb-6" data-ps="src/components/home/Dismantle.astro:g31o5f">
          Defense Dismantling Strategy
        </div>
        <h2 class="reveal text-h2 font-black mb-8 leading-none" data-ps="src/components/home/Dismantle.astro:h2">
          THEY WILL BLAME YOU FOR THE IMPACT. <span class="text-primary" data-ps="src/components/home/Dismantle.astro:887li7">WE PROVE THE KINETICS.</span>
        </h2>
        <div class="reveal reveal-delay-1 space-y-6 text-lg text-muted-foreground max-w-2xl" data-ps="src/components/home/Dismantle.astro:g31o5e">
          <p data-ps="src/components/home/Dismantle.astro:o1s5q2">
            Within minutes of a highway collision, logistics carriers dispatch corporate risk investigators to the scene. Their objective is singular: prove you were in the truck's blind spot, speeding, or merged abruptly.
          </p>
          <p data-ps="src/components/home/Dismantle.astro:o1s5q1">
            Generalist lawyers who don't understand commercial brake lag and engine control module (ECM) data will settle cheap. We dismantle their defenses with mechanical engineers, accident reconstructionists, and federal FMCSA compliance experts.
          </p>
          <p class="font-bold text-foreground" data-ps="src/components/home/Dismantle.astro:o1s5q0">
            We don't wait for reports. We seize the evidence.
          </p>
        </div>
        <div class="reveal reveal-delay-2 mt-10" data-ps="src/components/home/Dismantle.astro:g31o5d">
          <a href="/litigation-process" class="inline-flex items-center gap-4 text-primary font-black font-display uppercase tracking-widest hover:gap-6 transition-all group" data-ps="src/components/home/Dismantle.astro:gxu90a">
            See Our Litigation Process
            <svg class="w-6 h-6 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>

      <!-- Image Side -->
      <div class="lg:col-span-5 order-1 lg:order-2" data-ps="src/components/home/Dismantle.astro:g31o5c">
        <div class="reveal-right relative aspect-square overflow-hidden border-2 border-border" data-ps="src/components/home/Dismantle.astro:g31o5b">
          <img 
            src="https://images.pexels.com/photos/10020438/pexels-photo-10020438.jpeg?auto=compress&cs=tinysrgb&w=1200" 
            srcset="https://images.pexels.com/photos/10020438/pexels-photo-10020438.jpeg?auto=compress&cs=tinysrgb&w=320 320w, https://images.pexels.com/photos/10020438/pexels-photo-10020438.jpeg?auto=compress&cs=tinysrgb&w=640 640w, https://images.pexels.com/photos/10020438/pexels-photo-10020438.jpeg?auto=compress&cs=tinysrgb&w=1024 1024w"
            sizes="(max-width: 1024px) 100vw, 40vw"
            alt="Truck tire skid marks on NJ highway asphalt" 
            class="h-full w-full object-cover grayscale contrast-125"
            loading="lazy" data-ps="src/components/home/Dismantle.astro:3wwj0x" />
          <div class="absolute inset-0 bg-primary/10 mix-blend-multiply" data-ps="src/components/home/Dismantle.astro:g31o5a"></div>
          <div class="absolute top-0 left-0 p-6 bg-black/60 backdrop-blur-sm border-r border-b border-border" data-ps="src/components/home/Dismantle.astro:g31o59">
            <div class="text-[10px] font-mono text-primary font-bold tracking-widest uppercase" data-ps="src/components/home/Dismantle.astro:g31o58">Exhibit B: Evidence Lock</div>
            <div class="text-xl font-black font-display text-white mt-1" data-ps="src/components/home/Dismantle.astro:g31o57">SECURED</div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

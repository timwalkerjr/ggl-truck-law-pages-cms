---
import Container from '@/components/Container.astro';
---

<section id="metrics" class="bg-surface py-12 border-y border-border" data-ps="src/components/home/Metrics.astro:m1">
  <Container>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12" data-ps="src/components/home/Metrics.astro:dj21rg">
      <div class="reveal text-center md:text-left" data-ps="src/components/home/Metrics.astro:dj21rh">
        <div class="text-4xl md:text-5xl font-black font-display text-primary mb-1 flex items-start justify-center md:justify-start" data-ps="src/components/home/Metrics.astro:dj21ri">
          80,000
          <a href="/references#1" class="text-xs font-mono text-muted-foreground hover:text-primary transition-colors ml-1 mt-1 no-underline" data-ps="src/components/home/Metrics.astro:wx185d">[1]</a>
        </div>
        <div class="text-[10px] font-mono tracking-widest text-muted-foreground uppercase" data-ps="src/components/home/Metrics.astro:flp8iu">LBS. Kinetic Mass</div>
        <p class="text-xs text-muted-foreground mt-2 max-w-[200px] mx-auto md:mx-0" data-ps="src/components/home/Metrics.astro:iwjc86">Maximum legal weight generating crushing physical forces.</p>
      </div>
      
      <div class="reveal reveal-delay-1 text-center md:text-left" data-ps="src/components/home/Metrics.astro:flp8it">
        <div class="text-4xl md:text-5xl font-black font-display text-foreground mb-1 flex items-start justify-center md:justify-start" data-ps="src/components/home/Metrics.astro:flp8is">
          11 HRS
          <a href="/references#3" class="text-xs font-mono text-muted-foreground hover:text-primary transition-colors ml-1 mt-1 no-underline" data-ps="src/components/home/Metrics.astro:wx185e">[3]</a>
        </div>
        <div class="text-[10px] font-mono tracking-widest text-muted-foreground uppercase" data-ps="src/components/home/Metrics.astro:flp8ir">Federal Drive Limit</div>
        <p class="text-xs text-muted-foreground mt-2 max-w-[200px] mx-auto md:mx-0" data-ps="src/components/home/Metrics.astro:iwjc87">Daily HOS limit frequently violated or falsified via logs.</p>
      </div>
      
      <div class="reveal reveal-delay-2 text-center md:text-left" data-ps="src/components/home/Metrics.astro:flp8iq">
        <div class="text-4xl md:text-5xl font-black font-display text-foreground mb-1 flex items-start justify-center md:justify-start" data-ps="src/components/home/Metrics.astro:flp8ip">
          400%
          <a href="/references#4" class="text-xs font-mono text-muted-foreground hover:text-primary transition-colors ml-1 mt-1 no-underline" data-ps="src/components/home/Metrics.astro:wx185f">[4]</a>
        </div>
        <div class="text-[10px] font-mono tracking-widest text-muted-foreground uppercase" data-ps="src/components/home/Metrics.astro:flp8io">Braking Distance</div>
        <p class="text-xs text-muted-foreground mt-2 max-w-[200px] mx-auto md:mx-0" data-ps="src/components/home/Metrics.astro:iwjc88">Extra space required for semi-trucks vs commuter cars.</p>
      </div>
      
      <div class="reveal reveal-delay-3 text-center md:text-left" data-ps="src/components/home/Metrics.astro:flp8in">
        <div class="text-4xl md:text-5xl font-black font-display text-primary mb-1" data-ps="src/components/home/Metrics.astro:flp8im">EXIT 9</div>
        <div class="text-[10px] font-mono tracking-widest text-muted-foreground uppercase" data-ps="src/components/home/Metrics.astro:flp8il">Middlesex Hub</div>
        <p class="text-xs text-muted-foreground mt-2 max-w-[200px] mx-auto md:mx-0" data-ps="src/components/home/Metrics.astro:iwjc89">Route 1 & 18 corridors where local driver errors peak.</p>
      </div>
    </div>
  </Container>
</section>

---
import Container from '@/components/Container.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<section id="intel" class="bg-background py-20 md:py-32" data-ps="src/components/home/Intel.astro:i1">
  <Container>
    <div class="max-w-4xl mb-16" data-ps="src/components/home/Intel.astro:okmux6">
      <div class="reveal inline-block px-3 py-1 border-l-2 border-primary text-[10px] font-mono font-bold tracking-[0.3em] text-primary uppercase mb-6" data-ps="src/components/home/Intel.astro:okmux7">
        Forensic Intelligence
      </div>
      <h2 class="reveal text-h2 font-black mb-6" data-ps="src/components/home/Intel.astro:ascv9s">THE TRUCKER'S <span class="text-primary" data-ps="src/components/home/Intel.astro:q7l3cn">LEGAL INTEL</span></h2>
      <p class="reveal reveal-delay-1 text-xl text-muted-foreground mb-8" data-ps="src/components/home/Intel.astro:52nmu6">Industry analysis, FMCSA safety protocols, and New Brunswick crash navigation strategies.</p>
      <div class="reveal reveal-delay-2" data-ps="src/components/home/Intel.astro:okmuxc">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold font-display uppercase tracking-widest text-primary hover:text-primary-hover transition-colors group" data-ps="src/components/home/Intel.astro:rvzxwv">
          View All Intel
          <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8" data-ps="src/components/home/Intel.astro:okmux8">
      {sortedPosts.map((post, __psIdx) => (
        <a href={`/blog/${post.id}`} class="reveal group flex flex-col bg-surface border border-border hover:border-primary transition-colors overflow-hidden no-underline" data-ps={`src/components/home/Intel.astro:c6ljjy-${__psIdx}`}>
          {post.data.image && (
            <div class="aspect-[16/9] overflow-hidden border-b border-border relative" data-ps={`src/components/home/Intel.astro:okmux9-${__psIdx}`}>
              <img 
                src={post.data.image} 
                alt={post.data.title} 
                class="h-full w-full object-cover grayscale brightness-75 group-hover:scale-105 group-hover:grayscale-0 transition-all duration-500"
                loading="lazy"
                crossorigin="anonymous" data-ps={`src/components/home/Intel.astro:5am3q3-${__psIdx}`} />
              <div class="absolute top-4 left-4 px-2 py-1 bg-primary text-primary-foreground font-mono text-[9px] font-bold uppercase tracking-tighter" data-ps={`src/components/home/Intel.astro:okmuxa-${__psIdx}`}>
                {post.data.category}
              </div>
            </div>
          )}
          <div class="p-8 flex flex-col flex-grow" data-ps={`src/components/home/Intel.astro:okmuxb-${__psIdx}`}>
            <time class="text-[10px] font-mono text-muted-foreground mb-4 block uppercase tracking-widest">
              {post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <h3 class="text-xl font-black font-display text-foreground mb-4 group-hover:text-primary transition-colors leading-tight" data-ps={`src/components/home/Intel.astro:b9eiep-${__psIdx}`}>
              {post.data.title}
            </h3>
            <p class="text-sm text-muted-foreground line-clamp-3 mb-6" data-ps={`src/components/home/Intel.astro:52nmu7-${__psIdx}`}>
              {post.data.description}
            </p>
            <div class="mt-auto flex items-center gap-2 text-[10px] font-black font-display text-primary uppercase tracking-widest group-hover:gap-4 transition-all" data-ps={`src/components/home/Intel.astro:okmuxc-${__psIdx}`}>
              Read Intelligence <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
            </div>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>
